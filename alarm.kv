#:set COL_BG        (0.0, 0.0, 0.0, 1)
#:set COL_CARD      (0.055, 0.055, 0.06, 1)
#:set COL_CARD_DIM  (0.03, 0.03, 0.035, 1)
#:set COL_RED       (0.6118, 0.0471, 0.0471, 1)
#:set COL_RED_DIM   (0.25, 0.025, 0.03, 1)
#:set COL_TEXT      (0.96, 0.96, 0.96, 1)
#:set COL_SUBTEXT   (0.62, 0.58, 0.58, 1)


# --------------------------------------------------------------------
#  Reusable widget styles (classes live in main.py)
# --------------------------------------------------------------------
<HomeButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    bold: True
    font_size: "17sp"
    color: self.text_color
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: (0.72, 0.025, 0.055, 0.68)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
            width: dp(1.0)


<IOSToggle>:
    size_hint: None, None
    size: "52dp", "30dp"


<DigitInput>:
    multiline: False
    write_tab: False
    background_normal: ""
    background_active: ""
    background_color: COL_CARD
    foreground_color: COL_TEXT
    cursor_color: COL_RED
    selection_color: 0.82, 0.10, 0.13, 0.45
    halign: "center"
    padding: [0, max(0, (self.height - self.line_height) / 2), 0, 0]


# --------------------------------------------------------------------
#  Screen 1 - Home
# --------------------------------------------------------------------
<HomeScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size
        # Corner flares keep the black surface dimensional without image assets.
        Color:
            rgba: 0.28, 0.008, 0.025, 0.38
        Ellipse:
            pos: self.x - self.width * 0.54, self.top - self.height * 0.38
            size: self.width * 0.94, self.width * 0.94
        Color:
            rgba: 0.22, 0.005, 0.02, 0.30
        Ellipse:
            pos: self.right - self.width * 0.42, self.y - self.width * 0.32
            size: self.width * 0.76, self.width * 0.76

    BoxLayout:
        orientation: "vertical"
        padding: dp(22), dp(22), dp(22), dp(20)
        spacing: dp(8)

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(44)
            spacing: dp(8)
            VectorHomeIcon:
                kind: "brand"
                icon_color: (1, 0.10, 0.17, 1)
                size_hint: None, 1
                width: dp(46)
            Label:
                text: "[color=#ff2436][b]RED[/b][/color] [color=#f7f7fa][b]ALARM[/b][/color]"
                markup: True
                halign: "left"
                valign: "middle"
                text_size: self.size
                font_size: "29sp"

        Label:
            text: "B U I L D   T O   A N N O Y   Y O U"
            color: (0.56, 0.56, 0.60, 1)
            font_size: "10sp"
            size_hint_y: None
            height: dp(19)

        AnalogClock:
            size_hint_y: 1

        AnchorLayout:
            size_hint_y: None
            height: dp(24)
            BoxLayout:
                orientation: "horizontal"
                size_hint: None, 1
                width: dp(270)
                spacing: dp(8)
                AnchorLayout:
                    size_hint: None, 1
                    width: dp(18)
                    VectorHomeIcon:
                        kind: "calendar"
                        icon_color: (1, 0.10, 0.17, 1)
                        size_hint: None, None
                        size: dp(16), dp(16)
                Label:
                    text: root.date_text
                    font_size: "15sp"
                    color: COL_TEXT
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

        AnchorLayout:
            size_hint_y: None
            height: dp(42)
            HomeButton:
                text: root.next_alarm_text
                font_size: "12sp"
                size_hint: (0.90, None)
                height: dp(39)
                bg_color: (0.075, 0.018, 0.024, 1)
                text_color: (1, 0.20, 0.28, 1)
                icon_kind: "alarm"
                icon_color: (1, 0.20, 0.28, 1)

        Widget:
            size_hint_y: None
            height: dp(4)

        HomeButton:
            text: "CHECK ALARMS      ›"
            icon_kind: "list"
            size_hint_y: None
            height: dp(60)
            bg_color: (0.055, 0.055, 0.063, 1)
            text_color: COL_TEXT
            font_size: "16sp"
            on_release: root.go_alarms()

        HomeButton:
            text: "SET NEW ALARM      ›"
            icon_kind: "plus"
            size_hint_y: None
            height: dp(60)
            bg_color: (0.70, 0.012, 0.055, 1)
            text_color: 1, 1, 1, 1
            font_size: "16sp"
            on_release: root.go_new_alarm()

# --------------------------------------------------------------------
#  Screen 2 - Alarm list
# --------------------------------------------------------------------
<AlarmInfoButton>:
    orientation: "vertical"
    padding: 0, "2dp"

    Label:
        text: root.time_text
        color: COL_TEXT
        font_size: "26sp"
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.size

    Label:
        text: root.sub_text
        color: COL_TEXT if root.primary_label else COL_SUBTEXT
        font_size: "12sp"
        halign: "left"
        valign: "middle"
        text_size: self.size
        size_hint_y: None
        height: dp(17)
    Label:
        text: root.days_text
        markup: True
        color: COL_SUBTEXT
        font_size: "11sp"
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.size
        size_hint_y: None
        height: dp(17)


<AlarmRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "88dp"
    padding: "14dp", "8dp", "10dp", "8dp"
    spacing: "8dp"

    canvas.before:
        Color:
            rgba: COL_CARD if root.enabled else COL_CARD_DIM
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(18)]
        Color:
            rgba: (0.65, 0.015, 0.045, 0.14 + 0.20 * root.neon_glow)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
            width: dp(4)
        Color:
            rgba: (0.70, 0.025, 0.055, 0.50 + 0.50 * root.neon_glow)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(18))
            width: dp(1.0 + 0.7 * root.neon_glow)
        Color:
            rgba: (1, 0.05, 0.14, 0.18 + 0.82 * root.neon_glow)
        Line:
            points: (self.x + dp(2), self.y + dp(15), self.x + dp(2), self.top - dp(15))
            width: dp(2.5)

    AnchorLayout:
        size_hint: None, 1
        width: dp(30) * root.selection_reveal
        opacity: root.selection_reveal
        disabled: not root.selection_mode
        anchor_x: "center"
        anchor_y: "center"

        AlarmSelectionIndicator:
            row: root
            selected: root.selected
            disabled: not root.selection_mode
            size_hint: None, None
            size: dp(24), dp(24)

    AlarmInfoButton:
        row: root
        time_text: root.time_text
        sub_text: root.sub_text
        primary_label: root.label_is_primary
        days_text: root.days_text
        dim: not root.enabled

    Button:
        text: "×"
        size_hint: None, None
        size: dp(30), dp(34)
        pos_hint: {"center_y": 0.5}
        background_normal: ""
        background_down: ""
        background_color: 0, 0, 0, 0
        color: (1, 0.48, 0.50, 1)
        font_size: "22sp"
        bold: True
        canvas.before:
            Color:
                rgba: (0.25, 0.045, 0.055, 1) if self.state == "normal" else (0.42, 0.07, 0.085, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]
        on_release: root.on_delete_press()

    IOSToggle:
        row: root
        active: root.enabled
        pos_hint: {"center_y": 0.5}
        disabled: root.selection_mode
        on_active: root.on_switch_active(self.active)


<AlarmListScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "44dp", "20dp", "20dp"
        spacing: "14dp"

        FloatLayout:
            size_hint_y: None
            height: dp(56)

            HomeButton:
                text: "BACK"
                font_size: "13sp"
                size_hint: None, None
                size: dp(82), dp(48)
                pos_hint: {"x": 0, "center_y": 0.5}
                bg_color: 0.085, 0.075, 0.075, 1
                text_color: COL_TEXT
                on_release: root.go_home()

            Label:
                text: (str(root.selected_count) + " SELECTED") if root.selection_mode else "Alarms"
                font_size: "19sp" if root.selection_mode else "27sp"
                bold: True
                color: COL_TEXT
                size_hint: None, None
                size: dp(170), dp(48)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                halign: "center"
                valign: "middle"
                text_size: self.size

            HomeButton:
                text: "+"
                font_size: "24sp"
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"right": 1, "center_y": 0.5}
                bg_color: COL_RED
                text_color: 1, 1, 1, 1
                on_release: root.open_new_alarm()

        HomeButton:
            text: "Exact alarms are blocked - tap to allow"
            size_hint: 1, None
            height: 0 if root.exact_alarm_ok else dp(40)
            opacity: 0 if root.exact_alarm_ok else 1
            disabled: root.exact_alarm_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_permission_settings()

        HomeButton:
            text: "Battery saver may kill alarms - tap to allow"
            size_hint: 1, None
            height: 0 if root.battery_ok else dp(40)
            opacity: 0 if root.battery_ok else 1
            disabled: root.battery_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_battery_settings()

        HomeButton:
            text: "Allow full-screen alarms on lock screen - tap to allow"
            size_hint: 1, None
            height: 0 if root.fsi_ok else dp(40)
            opacity: 0 if root.fsi_ok else 1
            disabled: root.fsi_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_fsi_settings()

        HomeButton:
            text: "Allow display over other apps - tap to allow"
            size_hint: 1, None
            height: 0 if root.overlay_ok else dp(40)
            opacity: 0 if root.overlay_ok else 1
            disabled: root.overlay_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_overlay_settings()

        AnchorLayout:
            size_hint_y: None
            # A larger parent hit area makes the control easy to tap reliably.
            height: dp(54)
            anchor_x: "right"
            HomeButton:
                text: "CANCEL" if root.selection_mode else "SELECT"
                font_size: "12sp"
                size_hint: None, None
                size: dp(136), dp(48)
                bg_color: (0.10, 0.035, 0.045, 1) if root.selection_mode else (0.06, 0.06, 0.07, 1)
                text_color: COL_TEXT
                # Enter selection immediately on touch-down instead of waiting
                # for release; bind only once to avoid SELECT then CANCEL firing.
                on_press: root.cancel_selection() if root.selection_mode else root.start_selection()

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: root.selection_toolbar_height
            opacity: root.selection_toolbar_opacity
            disabled: not root.selection_mode
            spacing: dp(7)
            padding: dp(10), dp(8), dp(10), dp(8)
            canvas.before:
                Color:
                    rgba: (0.028, 0.028, 0.034, 0.98)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(16)]
                Color:
                    rgba: (0.72, 0.025, 0.055, 0.85)
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
                    width: dp(1)
            Label:
                text: str(root.selected_count) + " ALARM" + ("S" if root.selected_count != 1 else "") + " SELECTED"
                color: (1, 0.24, 0.32, 1)
                bold: True
                font_size: "10sp"
                size_hint_y: None
                height: dp(18)
            BoxLayout:
                orientation: "horizontal"
                spacing: dp(6)
                size_hint_y: None
                height: dp(48)
                HomeButton:
                    text: "UNSELECT ALL" if root.all_selected else "SELECT ALL"
                    font_size: "10sp"
                    bg_color: (0.10, 0.035, 0.045, 1)
                    text_color: COL_TEXT
                    on_release: root.select_all_selected()
                HomeButton:
                    text: "DELETE"
                    font_size: "10sp"
                    bg_color: (0.68, 0.012, 0.05, 1)
                    text_color: 1, 1, 1, 1
                    disabled: root.selected_count == 0
                    opacity: 0.45 if root.selected_count == 0 else 1
                    on_release: root.confirm_delete_selected()
                HomeButton:
                    text: "COPY"
                    font_size: "10sp"
                    bg_color: (0.07, 0.07, 0.08, 1)
                    text_color: COL_TEXT
                    disabled: root.selected_count == 0
                    opacity: 0.45 if root.selected_count == 0 else 1
                    on_release: root.copy_selected()

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                id: alarms_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"


# --------------------------------------------------------------------
#  Screen 3 - Add / edit alarm
# --------------------------------------------------------------------
<AlarmEditScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size


<AlarmRingScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: COL_RED_DIM
        Ellipse:
            pos: self.center_x - self.width * 0.9, self.height * 0.60
            size: self.width * 1.8, self.width * 1.8

    BoxLayout:
        orientation: "vertical"
        padding: "28dp", "50dp", "28dp", "34dp"
        spacing: "8dp"

        Label:
            text: root.label_text
            font_size: "20sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "28dp"
            halign: "left"
            text_size: self.size

        Label:
            text: root.time_text
            font_size: "50sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "66dp"
            halign: "left"
            text_size: self.size

        # ---- big, unmissable auto-dismiss countdown ----
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "150dp"
            padding: "10dp"
            canvas.before:
                Color:
                    rgba: 0.22, 0.05, 0.06, 0.92
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(20)]
                Color:
                    rgba: COL_RED
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
                    width: dp(1.4)

            Label:
                text: "AUTO-DISMISS IN" if root.auto_dismiss_enabled else "AUTO-DISMISS OFF"
                font_size: "13sp"
                bold: True
                color: 0.90, 0.60, 0.60, 1
                size_hint_y: None
                height: "20dp"

            Label:
                text: root.countdown_text
                font_size: "76sp"
                bold: True
                color: 1, 1, 1, 1

        Widget:

        HomeButton:
            text: "Snooze"
            size_hint: None, None
            size: "170dp", "48dp"
            pos_hint: {"center_x": 0.5}
            bg_color: 0.16, 0.16, 0.16, 1
            text_color: 1, 1, 1, 1
            disabled: not root.snooze_enabled
            opacity: 1 if root.snooze_enabled else 0
            on_release: root.snooze_pressed()

        Widget:
            size_hint_y: None
            height: "10dp"

        Button:
            text: "Dismiss"
            size_hint: None, None
            size: "150dp", "150dp"
            pos_hint: {"center_x": 0.5}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: "18sp"
            bold: True
            canvas.before:
                Color:
                    rgba: 0.82, 0.10, 0.13, 0.16
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: COL_RED
                Line:
                    circle: (self.center_x, self.center_y, self.width / 2 - 3)
                    width: 2.4
            on_release: root.dismiss_pressed()
