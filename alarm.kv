#:set COL_BG        (0.04, 0.04, 0.045, 1)
#:set COL_CARD      (0.11, 0.09, 0.09, 1)
#:set COL_CARD_DIM  (0.085, 0.075, 0.075, 1)
#:set COL_RED       (0.82, 0.10, 0.13, 1)
#:set COL_RED_DIM   (0.42, 0.06, 0.08, 1)
#:set COL_TEXT      (0.96, 0.96, 0.96, 1)
#:set COL_SUBTEXT   (0.62, 0.58, 0.58, 1)


# --------------------------------------------------------------------
#  Reusable widget styles (classes live in main.py)
# --------------------------------------------------------------------
<HomeButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    bold: True
    font_size: "17sp"
    color: self.text_color
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]


<IOSToggle>:
    size_hint: None, None
    size: "52dp", "30dp"


<DigitInput>:
    multiline: False
    write_tab: False
    background_normal: ""
    background_active: ""
    background_color: COL_CARD
    foreground_color: COL_TEXT
    cursor_color: COL_RED
    selection_color: 0.82, 0.10, 0.13, 0.45
    halign: "center"
    padding: [0, max(0, (self.height - self.line_height) / 2), 0, 0]


# --------------------------------------------------------------------
#  Screen 1 - Home
# --------------------------------------------------------------------
<HomeScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size
        # subtle red glow behind the clock
        Color:
            rgba: 0.30, 0.05, 0.06, 0.40
        Ellipse:
            pos: self.center_x - self.width * 0.6, self.height * 0.55 - self.width * 0.6
            size: self.width * 1.2, self.width * 1.2

    BoxLayout:
        orientation: "vertical"
        padding: "24dp", "44dp", "24dp", "30dp"
        spacing: "10dp"

        # ---------- TITLE ----------
        Label:
            text: "[color=d11a21][b]RED[/b][/color] [b]ALARM[/b]"
            markup: True
            font_size: "34sp"
            color: COL_TEXT
            size_hint_y: None
            height: "50dp"

        Label:
            text: "build to annoy you"
            color: COL_SUBTEXT
            font_size: "13sp"
            size_hint_y: None
            height: "18dp"

        # ---------- CLOCK ----------
        AnalogClock:
            size_hint_y: 1

        Label:
            text: root.date_text
            font_size: "15sp"
            color: COL_SUBTEXT
            size_hint_y: None
            height: "22dp"

        Label:
            text: root.next_alarm_text
            font_size: "14sp"
            bold: True
            color: COL_RED
            size_hint_y: None
            height: "20dp"

        # ---------- BUTTONS ----------
        HomeButton:
            text: "Check Alarms"
            size_hint_y: None
            height: "54dp"
            bg_color: COL_CARD
            text_color: COL_TEXT
            on_release: root.go_alarms()

        HomeButton:
            text: "Set New Alarm"
            size_hint_y: None
            height: "54dp"
            bg_color: COL_RED
            text_color: 1, 1, 1, 1
            on_release: root.go_new_alarm()


# --------------------------------------------------------------------
#  Screen 2 - Alarm list
# --------------------------------------------------------------------
<AlarmInfoButton>:
    orientation: "vertical"
    padding: 0, "2dp"

    Label:
        text: root.time_text
        color: COL_SUBTEXT if root.dim else COL_TEXT
        font_size: "26sp"
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.size

    Label:
        text: root.sub_text
        color: COL_SUBTEXT
        font_size: "13sp"
        halign: "left"
        valign: "middle"
        text_size: self.size


<AlarmRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "76dp"
    padding: "14dp", "8dp", "10dp", "8dp"
    spacing: "8dp"

    canvas.before:
        Color:
            rgba: COL_CARD if root.enabled else COL_CARD_DIM
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]

    AlarmInfoButton:
        row: root
        time_text: root.time_text
        sub_text: root.sub_text
        dim: not root.enabled

    Button:
        text: "x"
        size_hint: None, None
        size: "40dp", "40dp"
        pos_hint: {"center_y": 0.5}
        background_normal: ""
        background_down: ""
        background_color: 0, 0, 0, 0
        color: COL_SUBTEXT
        font_size: "20sp"
        on_release: root.on_delete_press()

    IOSToggle:
        active: root.enabled
        pos_hint: {"center_y": 0.5}
        on_active: root.on_switch_active(self.active)


<AlarmListScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "44dp", "20dp", "20dp"
        spacing: "14dp"

        BoxLayout:
            size_hint_y: None
            height: "48dp"

            Button:
                text: "<"
                font_size: "24sp"
                bold: True
                size_hint: None, None
                size: "48dp", "48dp"
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                color: COL_TEXT
                on_release: root.go_home()

            Label:
                text: "Alarms"
                font_size: "30sp"
                bold: True
                color: COL_TEXT
                halign: "left"
                valign: "middle"
                text_size: self.size

            HomeButton:
                text: "+"
                font_size: "24sp"
                size_hint: None, None
                size: "48dp", "48dp"
                bg_color: COL_RED
                text_color: 1, 1, 1, 1
                on_release: root.open_new_alarm()

        HomeButton:
            text: "Exact alarms are blocked - tap to allow"
            size_hint: 1, None
            height: 0 if root.exact_alarm_ok else dp(40)
            opacity: 0 if root.exact_alarm_ok else 1
            disabled: root.exact_alarm_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_permission_settings()

        HomeButton:
            text: "Battery saver may kill alarms - tap to allow"
            size_hint: 1, None
            height: 0 if root.battery_ok else dp(40)
            opacity: 0 if root.battery_ok else 1
            disabled: root.battery_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_battery_settings()

        HomeButton:
            text: "Allow full-screen alarms on lock screen - tap to allow"
            size_hint: 1, None
            height: 0 if root.fsi_ok else dp(40)
            opacity: 0 if root.fsi_ok else 1
            disabled: root.fsi_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_fsi_settings()

        HomeButton:
            text: "Allow display over other apps - tap to allow"
            size_hint: 1, None
            height: 0 if root.overlay_ok else dp(40)
            opacity: 0 if root.overlay_ok else 1
            disabled: root.overlay_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_overlay_settings()

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                id: alarms_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"


# --------------------------------------------------------------------
#  Screen 3 - Add / edit alarm
# --------------------------------------------------------------------
<AlarmEditScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "44dp", "20dp", "20dp"
        spacing: "14dp"

        # ---------- top bar ----------
        BoxLayout:
            size_hint_y: None
            height: "36dp"

            Button:
                text: "Cancel"
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                color: COL_SUBTEXT
                on_release: root.cancel_edit()

            Widget:

            Button:
                id: delete_btn
                text: "Delete"
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                color: COL_RED
                on_release: root.delete_alarm()

            Widget:

            Button:
                text: "Save"
                bold: True
                background_normal: ""
                background_down: ""
                background_color: 0, 0, 0, 0
                color: COL_RED
                on_release: root.save_alarm()

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "20dp"
                padding: 0, "6dp"

                # ---------- time: HH : MM  [AM|PM] ----------
                BoxLayout:
                    size_hint_y: None
                    height: "88dp"
                    spacing: "8dp"

                    DigitInput:
                        id: input_hour
                        text: "07"
                        font_size: "44sp"
                        bold: True
                        max_chars: 2

                    Label:
                        text: ":"
                        font_size: "40sp"
                        bold: True
                        color: COL_RED
                        size_hint_x: None
                        width: "14dp"

                    DigitInput:
                        id: input_minute
                        text: "00"
                        font_size: "44sp"
                        bold: True
                        max_chars: 2

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: None
                        width: "76dp"
                        spacing: "8dp"

                        HomeButton:
                            text: "AM"
                            bg_color: COL_RED if root.ampm == "AM" else COL_CARD
                            text_color: (1, 1, 1, 1) if root.ampm == "AM" else COL_SUBTEXT
                            on_release: root.set_ampm("AM")

                        HomeButton:
                            text: "PM"
                            bg_color: COL_RED if root.ampm == "PM" else COL_CARD
                            text_color: (1, 1, 1, 1) if root.ampm == "PM" else COL_SUBTEXT
                            on_release: root.set_ampm("PM")

                HomeButton:
                    text: "Pick time  (hour > minutes > AM/PM)"
                    size_hint_y: None
                    height: "42dp"
                    bold: False
                    font_size: "13.5sp"
                    bg_color: COL_RED_DIM
                    text_color: 1, 1, 1, 1
                    on_release: root.open_time_picker()

                # ---------- repeat ----------
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "70dp"
                    spacing: "6dp"

                    Label:
                        text: "Repeat (leave blank for a one-time alarm)"
                        color: COL_SUBTEXT
                        font_size: "12sp"
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    BoxLayout:
                        spacing: "6dp"

                        ToggleButton:
                            id: day_0
                            text: "M"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(0, self.state == "down")

                        ToggleButton:
                            id: day_1
                            text: "T"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(1, self.state == "down")

                        ToggleButton:
                            id: day_2
                            text: "W"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(2, self.state == "down")

                        ToggleButton:
                            id: day_3
                            text: "T"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(3, self.state == "down")

                        ToggleButton:
                            id: day_4
                            text: "F"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(4, self.state == "down")

                        ToggleButton:
                            id: day_5
                            text: "S"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(5, self.state == "down")

                        ToggleButton:
                            id: day_6
                            text: "S"
                            background_normal: ""
                            background_down: ""
                            background_color: COL_RED if self.state == "down" else COL_CARD
                            on_state: root.set_day(6, self.state == "down")

                # ---------- label ----------
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "64dp"
                    spacing: "6dp"

                    Label:
                        text: "Label"
                        color: COL_SUBTEXT
                        font_size: "12sp"
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    TextInput:
                        id: label_input
                        hint_text: "e.g. Wake up"
                        multiline: False
                        background_normal: ""
                        background_active: ""
                        background_color: COL_CARD
                        foreground_color: COL_TEXT
                        hint_text_color: COL_SUBTEXT
                        cursor_color: COL_RED
                        padding: "12dp", "12dp"

                # ---------- sound ----------
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: "76dp"
                    spacing: "6dp"

                    Label:
                        text: "Alarm sound"
                        color: COL_SUBTEXT
                        font_size: "12sp"
                        size_hint_y: None
                        height: "16dp"
                        halign: "left"
                        text_size: self.size

                    BoxLayout:
                        spacing: "8dp"

                        HomeButton:
                            text: root.sound_name
                            bold: False
                            bg_color: COL_CARD
                            text_color: COL_TEXT
                            on_release: root.choose_sound()

                        HomeButton:
                            text: "Preview"
                            size_hint_x: None
                            width: "84dp"
                            bg_color: COL_RED_DIM
                            text_color: 1, 1, 1, 1
                            on_release: root.preview_sound()

                # ---------- vibration ----------
                BoxLayout:
                    size_hint_y: None
                    height: "46dp"
                    spacing: "10dp"

                    Label:
                        text: "Vibrate"
                        color: COL_TEXT
                        font_size: "14.5sp"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    IOSToggle:
                        active: root.vibrate
                        size_hint_x: None
                        pos_hint: {"center_y": 0.5}
                        on_active: root.vibrate = self.active

                # ---------- auto-dismiss + snooze (minutes + seconds) ----------
                BoxLayout:
                    size_hint_y: None
                    height: "80dp"
                    spacing: "16dp"

                    BoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"

                        Label:
                            text: "Auto-dismiss after"
                            color: COL_SUBTEXT
                            font_size: "12sp"
                            size_hint_y: None
                            height: "16dp"
                            halign: "left"
                            text_size: self.size

                        BoxLayout:
                            spacing: "4dp"

                            DigitInput:
                                id: dismiss_min
                                text: "5"
                                font_size: "18sp"
                                max_chars: 3

                            Label:
                                text: "m"
                                size_hint_x: None
                                width: "12dp"
                                color: COL_SUBTEXT

                            DigitInput:
                                id: dismiss_sec
                                text: "0"
                                font_size: "18sp"
                                max_chars: 2

                            Label:
                                text: "s"
                                size_hint_x: None
                                width: "12dp"
                                color: COL_SUBTEXT

                    BoxLayout:
                        orientation: "vertical"
                        spacing: "6dp"

                        Label:
                            text: "Snooze for"
                            color: COL_SUBTEXT
                            font_size: "12sp"
                            size_hint_y: None
                            height: "16dp"
                            halign: "left"
                            text_size: self.size

                        BoxLayout:
                            spacing: "4dp"

                            DigitInput:
                                id: snooze_min
                                text: "5"
                                font_size: "18sp"
                                max_chars: 3

                            Label:
                                text: "m"
                                size_hint_x: None
                                width: "12dp"
                                color: COL_SUBTEXT

                            DigitInput:
                                id: snooze_sec
                                text: "0"
                                font_size: "18sp"
                                max_chars: 2

                            Label:
                                text: "s"
                                size_hint_x: None
                                width: "12dp"
                                color: COL_SUBTEXT

                Label:
                    id: error_label
                    text: ""
                    color: COL_RED
                    size_hint_y: None
                    height: "22dp"
                    font_size: "12.5sp"
                    halign: "left"
                    text_size: self.size


# --------------------------------------------------------------------
#  Screen 4 - Ringing
# --------------------------------------------------------------------
<AlarmRingScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: COL_RED_DIM
        Ellipse:
            pos: self.center_x - self.width * 0.9, self.height * 0.60
            size: self.width * 1.8, self.width * 1.8

    BoxLayout:
        orientation: "vertical"
        padding: "28dp", "50dp", "28dp", "34dp"
        spacing: "8dp"

        Label:
            text: root.label_text
            font_size: "20sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "28dp"
            halign: "left"
            text_size: self.size

        Label:
            text: root.time_text
            font_size: "50sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "66dp"
            halign: "left"
            text_size: self.size

        # ---- big, unmissable auto-dismiss countdown ----
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "150dp"
            padding: "10dp"
            canvas.before:
                Color:
                    rgba: 0.22, 0.05, 0.06, 0.92
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(20)]
                Color:
                    rgba: COL_RED
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
                    width: dp(1.4)

            Label:
                text: "AUTO-DISMISS IN"
                font_size: "13sp"
                bold: True
                color: 0.90, 0.60, 0.60, 1
                size_hint_y: None
                height: "20dp"

            Label:
                text: root.countdown_text
                font_size: "76sp"
                bold: True
                color: 1, 1, 1, 1

        Widget:

        HomeButton:
            text: "Snooze"
            size_hint: None, None
            size: "170dp", "48dp"
            pos_hint: {"center_x": 0.5}
            bg_color: 0.16, 0.16, 0.16, 1
            text_color: 1, 1, 1, 1
            on_release: root.snooze_pressed()

        Widget:
            size_hint_y: None
            height: "10dp"

        Button:
            text: "Dismiss"
            size_hint: None, None
            size: "150dp", "150dp"
            pos_hint: {"center_x": 0.5}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: "18sp"
            bold: True
            canvas.before:
                Color:
                    rgba: 0.82, 0.10, 0.13, 0.16
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: COL_RED
                Line:
                    circle: (self.center_x, self.center_y, self.width / 2 - 3)
                    width: 2.4
            on_release: root.dismiss_pressed()
