#:set COL_BG        (0.0, 0.0, 0.0, 1)
#:set COL_CARD      (0.055, 0.055, 0.06, 1)
#:set COL_CARD_DIM  (0.03, 0.03, 0.035, 1)
#:set COL_RED       (0.6118, 0.0471, 0.0471, 1)
#:set COL_RED_DIM   (0.25, 0.025, 0.03, 1)
#:set COL_TEXT      (0.96, 0.96, 0.96, 1)
#:set COL_SUBTEXT   (0.62, 0.58, 0.58, 1)


# --------------------------------------------------------------------
#  Reusable widget styles (classes live in main.py)
# --------------------------------------------------------------------
<HomeButton>:
    background_normal: ""
    background_down: ""
    background_color: 0, 0, 0, 0
    bold: True
    font_size: "17sp"
    color: self.text_color
    canvas.before:
        Color:
            rgba: self.bg_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]


<IOSToggle>:
    size_hint: None, None
    size: "52dp", "30dp"


<DigitInput>:
    multiline: False
    write_tab: False
    background_normal: ""
    background_active: ""
    background_color: COL_CARD
    foreground_color: COL_TEXT
    cursor_color: COL_RED
    selection_color: 0.82, 0.10, 0.13, 0.45
    halign: "center"
    padding: [0, max(0, (self.height - self.line_height) / 2), 0, 0]


# --------------------------------------------------------------------
#  Screen 1 - Home
# --------------------------------------------------------------------
<HomeScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size
        # subtle red glow behind the clock
        Color:
            rgba: 0.30, 0.05, 0.06, 0.40
        Ellipse:
            pos: self.center_x - self.width * 0.6, self.height * 0.55 - self.width * 0.6
            size: self.width * 1.2, self.width * 1.2

    BoxLayout:
        orientation: "vertical"
        padding: "24dp", "44dp", "24dp", "30dp"
        spacing: "10dp"

        # ---------- TITLE ----------
        Label:
            text: "[color=d11a21][b]RED[/b][/color] [b]ALARM[/b]"
            markup: True
            font_size: "34sp"
            color: COL_TEXT
            size_hint_y: None
            height: "50dp"

        Label:
            text: "build to annoy you"
            color: COL_SUBTEXT
            font_size: "13sp"
            size_hint_y: None
            height: "18dp"

        # ---------- CLOCK ----------
        AnalogClock:
            size_hint_y: 1

        Label:
            text: root.date_text
            font_size: "15sp"
            color: COL_SUBTEXT
            size_hint_y: None
            height: "22dp"

        Label:
            text: root.next_alarm_text
            font_size: "14sp"
            bold: True
            color: COL_RED
            size_hint_y: None
            height: "20dp"

        # ---------- BUTTONS ----------
        HomeButton:
            text: "Check Alarms"
            size_hint_y: None
            height: "54dp"
            bg_color: COL_CARD
            text_color: COL_TEXT
            on_release: root.go_alarms()

        HomeButton:
            text: "Set New Alarm"
            size_hint_y: None
            height: "54dp"
            bg_color: COL_RED
            text_color: 1, 1, 1, 1
            on_release: root.go_new_alarm()


# --------------------------------------------------------------------
#  Screen 2 - Alarm list
# --------------------------------------------------------------------
<AlarmInfoButton>:
    orientation: "vertical"
    padding: 0, "2dp"

    Label:
        text: root.time_text
        color: COL_TEXT
        font_size: "26sp"
        bold: True
        halign: "left"
        valign: "middle"
        text_size: self.size

    Label:
        text: root.sub_text
        color: COL_TEXT if root.primary_label else COL_SUBTEXT
        font_size: "13sp"
        halign: "left"
        valign: "middle"
        text_size: self.size


<AlarmRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "76dp"
    padding: "14dp", "8dp", "10dp", "8dp"
    spacing: "8dp"

    canvas.before:
        Color:
            rgba: COL_CARD if root.enabled else COL_CARD_DIM
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: COL_RED if root.selected else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(16))
            width: dp(1.0)

    AnchorLayout:
        size_hint: None, 1
        width: dp(30) if root.selection_mode else 0
        opacity: 1 if root.selection_mode else 0
        disabled: not root.selection_mode
        anchor_x: "center"
        anchor_y: "center"

        AlarmSelectionIndicator:
            row: root
            selected: root.selected
            disabled: not root.selection_mode
            size_hint: None, None
            size: dp(24), dp(24)

    AlarmInfoButton:
        row: root
        time_text: root.time_text
        sub_text: root.sub_text
        primary_label: root.label_is_primary
        dim: not root.enabled

    Button:
        text: "×"
        size_hint: None, None
        size: dp(30), dp(34)
        pos_hint: {"center_y": 0.5}
        background_normal: ""
        background_down: ""
        background_color: 0, 0, 0, 0
        color: (1, 0.48, 0.50, 1)
        font_size: "22sp"
        bold: True
        canvas.before:
            Color:
                rgba: (0.25, 0.045, 0.055, 1) if self.state == "normal" else (0.42, 0.07, 0.085, 1)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(10)]
        on_release: root.on_delete_press()

    IOSToggle:
        row: root
        active: root.enabled
        pos_hint: {"center_y": 0.5}
        disabled: root.selection_mode
        on_active: root.on_switch_active(self.active)


<AlarmListScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: "20dp", "44dp", "20dp", "20dp"
        spacing: "14dp"

        FloatLayout:
            size_hint_y: None
            height: dp(56)

            HomeButton:
                text: "BACK"
                font_size: "13sp"
                size_hint: None, None
                size: dp(82), dp(48)
                pos_hint: {"x": 0, "center_y": 0.5}
                bg_color: 0.085, 0.075, 0.075, 1
                text_color: COL_TEXT
                on_release: root.go_home()

            Label:
                text: "Alarms"
                font_size: "27sp"
                bold: True
                color: COL_TEXT
                size_hint: None, None
                size: dp(170), dp(48)
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                halign: "center"
                valign: "middle"
                text_size: self.size

            HomeButton:
                text: "+"
                font_size: "24sp"
                size_hint: None, None
                size: dp(48), dp(48)
                pos_hint: {"right": 1, "center_y": 0.5}
                bg_color: COL_RED
                text_color: 1, 1, 1, 1
                on_release: root.open_new_alarm()

        HomeButton:
            text: "Exact alarms are blocked - tap to allow"
            size_hint: 1, None
            height: 0 if root.exact_alarm_ok else dp(40)
            opacity: 0 if root.exact_alarm_ok else 1
            disabled: root.exact_alarm_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_permission_settings()

        HomeButton:
            text: "Battery saver may kill alarms - tap to allow"
            size_hint: 1, None
            height: 0 if root.battery_ok else dp(40)
            opacity: 0 if root.battery_ok else 1
            disabled: root.battery_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_battery_settings()

        HomeButton:
            text: "Allow full-screen alarms on lock screen - tap to allow"
            size_hint: 1, None
            height: 0 if root.fsi_ok else dp(40)
            opacity: 0 if root.fsi_ok else 1
            disabled: root.fsi_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_fsi_settings()

        HomeButton:
            text: "Allow display over other apps - tap to allow"
            size_hint: 1, None
            height: 0 if root.overlay_ok else dp(40)
            opacity: 0 if root.overlay_ok else 1
            disabled: root.overlay_ok
            bold: False
            font_size: "12.5sp"
            bg_color: COL_RED_DIM
            text_color: 1, 1, 1, 1
            on_release: root.open_overlay_settings()

        ScrollView:
            do_scroll_x: False
            bar_width: 0

            BoxLayout:
                id: alarms_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(62) if root.selection_mode else 0
            opacity: 1 if root.selection_mode else 0
            disabled: not root.selection_mode
            spacing: dp(10)
            padding: 0, dp(6), 0, 0
            canvas.before:
                Color:
                    rgba: (0.045, 0.045, 0.05, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: (0.20, 0.20, 0.22, 1)
                Line:
                    points: self.x, self.top, self.right, self.top
                    width: dp(0.8)

            HomeButton:
                text: "Deselect All" if root.all_selected else "Select All"
                font_size: "12sp"
                size_hint_y: None
                height: dp(48)
                bg_color: (0.11, 0.11, 0.12, 1)
                text_color: COL_TEXT
                on_release: root.select_all_selected()

            HomeButton:
                text: "Copy"
                font_size: "12sp"
                size_hint_y: None
                height: dp(48)
                bg_color: (0.11, 0.11, 0.12, 1)
                text_color: COL_TEXT
                disabled: root.selected_count == 0
                opacity: 0.48 if root.selected_count == 0 else 1
                on_release: root.copy_selected()

            HomeButton:
                text: "Delete"
                font_size: "12sp"
                size_hint_y: None
                height: dp(48)
                bg_color: COL_RED
                text_color: 1, 1, 1, 1
                disabled: root.selected_count == 0
                opacity: 0.48 if root.selected_count == 0 else 1
                on_release: root.confirm_delete_selected()


# --------------------------------------------------------------------
#  Screen 3 - Add / edit alarm
# --------------------------------------------------------------------
<AlarmEditScreen>:
    canvas.before:
        Color:
            rgba: COL_BG
        Rectangle:
            pos: self.pos
            size: self.size


<AlarmRingScreen>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: COL_RED_DIM
        Ellipse:
            pos: self.center_x - self.width * 0.9, self.height * 0.60
            size: self.width * 1.8, self.width * 1.8

    BoxLayout:
        orientation: "vertical"
        padding: "28dp", "50dp", "28dp", "34dp"
        spacing: "8dp"

        Label:
            text: root.label_text
            font_size: "20sp"
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "28dp"
            halign: "left"
            text_size: self.size

        Label:
            text: root.time_text
            font_size: "50sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: "66dp"
            halign: "left"
            text_size: self.size

        # ---- big, unmissable auto-dismiss countdown ----
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "150dp"
            padding: "10dp"
            canvas.before:
                Color:
                    rgba: 0.22, 0.05, 0.06, 0.92
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(20)]
                Color:
                    rgba: COL_RED
                Line:
                    rounded_rectangle: (self.x, self.y, self.width, self.height, dp(20))
                    width: dp(1.4)

            Label:
                text: "AUTO-DISMISS IN"
                font_size: "13sp"
                bold: True
                color: 0.90, 0.60, 0.60, 1
                size_hint_y: None
                height: "20dp"

            Label:
                text: root.countdown_text
                font_size: "76sp"
                bold: True
                color: 1, 1, 1, 1

        Widget:

        HomeButton:
            text: "Snooze"
            size_hint: None, None
            size: "170dp", "48dp"
            pos_hint: {"center_x": 0.5}
            bg_color: 0.16, 0.16, 0.16, 1
            text_color: 1, 1, 1, 1
            on_release: root.snooze_pressed()

        Widget:
            size_hint_y: None
            height: "10dp"

        Button:
            text: "Dismiss"
            size_hint: None, None
            size: "150dp", "150dp"
            pos_hint: {"center_x": 0.5}
            background_normal: ""
            background_down: ""
            background_color: 0, 0, 0, 0
            color: 1, 1, 1, 1
            font_size: "18sp"
            bold: True
            canvas.before:
                Color:
                    rgba: 0.82, 0.10, 0.13, 0.16
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: COL_RED
                Line:
                    circle: (self.center_x, self.center_y, self.width / 2 - 3)
                    width: 2.4
            on_release: root.dismiss_pressed()
