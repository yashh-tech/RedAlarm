<?xml version="1.0" encoding="utf-8"?>
<!-- One resizable widget with three designs: 4x2 (big), 4x1 (wide), 2x2 (square). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="420dp"
    android:maxResizeHeight="200dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:resizeMode="horizontal|vertical"
    android:previewImage="@drawable/redalarm_widget_preview"
    android:previewLayout="@layout/redalarm_widget_large"
    android:widgetCategory="home_screen"
    android:initialLayout="@layout/redalarm_widget_large" />
