<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2: countdown to the next alarm, its time, label and days. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ra_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/redalarm_widget_bg">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/redalarm_widget_icon"
        android:contentDescription="RedAlarm" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="Next Alarm In"
        android:textColor="#B9B9BE"
        android:textSize="11sp" />
    <TextView
        android:id="@+id/ra_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="--"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="3dp"
        android:background="#C8121C"
        android:contentDescription="" />
    <TextView
        android:id="@+id/ra_next_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="--:--"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/ra_next_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No alarm set"
        android:textColor="#B9B9BE"
        android:textSize="10sp" />
    <TextView
        android:id="@+id/ra_next_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="S M T W T F S"
        android:textColor="#6E6E73"
        android:textSize="10sp" />
</LinearLayout>
